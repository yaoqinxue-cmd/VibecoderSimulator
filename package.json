{
  "name": "vibecoder-simulator",
  "version": "0.1.0",
  "description": "A browser-based text simulator about what kind of person you become after you start vibe coding.",
  "private": true,
  "license": "MIT",
  "homepage": "https://yaoqinxue-cmd.github.io/VibecoderSimulator/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yaoqinxue-cmd/VibecoderSimulator.git"
  },
  "bugs": {
    "url": "https://github.com/yaoqinxue-cmd/VibecoderSimulator/issues"
  },
  "keywords": [
    "vibe-coding",
    "simulator",
    "text-game",
    "browser-game",
    "interactive-fiction",
    "react",
    "typescript",
    "vite"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "lint": "tsc --noEmit",
    "format": "prettier --check ."
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.0",
    "vite": "^6.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^25.0.0",
    "prettier": "^3.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
